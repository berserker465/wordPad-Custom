LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* Document-local settings saved in an RTF hidden metadata group. */
IDD_CLOUD_DOC_SETTINGS DIALOGEX 0, 0, 425, 281
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WordPad(Custom) - Cloud Backup Settings"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    AUTOCHECKBOX "Enable cloud backup for this document", IDC_CLOUD_DOC_ENABLE, 12, 8, 380, 18, WS_TABSTOP
    LTEXT "Google Drive folder to save this backup (ID or root):", IDC_CLOUD_DOC_FOLDER_LABEL, 12, 29, 399, 15
    EDITTEXT IDC_CLOUD_DOC_FOLDER, 12, 46, 190, 19, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Folder: (not checked)", IDC_CLOUD_DOC_FOLDER_NAME, 211, 46, 200, 19, SS_LEFTNOWORDWRAP | SS_ENDELLIPSIS | SS_CENTERIMAGE
    LTEXT "Minimum retained revisions (1-200):", IDC_CLOUD_DOC_MAXVERSIONS_LABEL, 12, 74, 302, 15
    EDITTEXT IDC_CLOUD_DOC_MAXVERSIONS, 324, 71, 87, 19, ES_NUMBER | WS_TABSTOP
    LTEXT "Keep all revisions from the last days (0 = off):", IDC_CLOUD_DOC_RETENTION_DAYS_LABEL, 12, 100, 302, 15
    EDITTEXT IDC_CLOUD_DOC_RETENTION_DAYS, 324, 97, 87, 19, ES_NUMBER | WS_TABSTOP
    LTEXT "Linked Google Drive file ID (updates the same file):", IDC_CLOUD_DOC_REMOTE_LABEL, 12, 126, 399, 15
    EDITTEXT IDC_CLOUD_DOC_REMOTE, 12, 144, 399, 19, ES_AUTOHSCROLL | ES_READONLY
    AUTOCHECKBOX "Automatically save this document at intervals", IDC_CLOUD_DOC_PERIODIC_ENABLE, 12, 173, 390, 18, WS_TABSTOP
    LTEXT "Automatic save interval (minutes, min. 10 sec):", IDC_CLOUD_DOC_PERIODIC_MINUTES_LABEL, 12, 202, 302, 15
    EDITTEXT IDC_CLOUD_DOC_PERIODIC_MINUTES, 324, 199, 87, 19, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "First upload: File > Upload to Google Drive. Later saves upload automatically; periodic saving requires cloud backup enabled.", IDC_CLOUD_DOC_NOTICE, 12, 226, 399, 18
    PUSHBUTTON "New Cloud Identity", IDC_CLOUD_DOC_DETACH, 12, 252, 130, 20
    DEFPUSHBUTTON "Save Settings", IDOK, 232, 252, 92, 20
    PUSHBUTTON "Cancel", IDCANCEL, 334, 252, 77, 20
END


IDD_CLOUD_NATIVE_UPLOAD DIALOGEX 0, 0, 450, 255
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WordPad(Custom) - Upload to Google Drive"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Document:", -1, 12, 12, 70, 10
    LTEXT "", IDC_CLOUD_NATIVE_DOCUMENT, 12, 27, 425, 18, SS_LEFTNOWORDWRAP
    LTEXT "Google OAuth Desktop Client ID:", -1, 12, 51, 235, 10
    PUSHBUTTON "Load OAuth JSON...", IDC_CLOUD_NATIVE_LOADJSON, 327, 48, 110, 18
    EDITTEXT IDC_CLOUD_NATIVE_CLIENT, 12, 70, 425, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Google OAuth Desktop Client Secret (optional with saved login):", -1, 12, 95, 425, 10
    EDITTEXT IDC_CLOUD_NATIVE_SECRET, 12, 110, 425, 16, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Save document to Google Drive folder (ID or root):", -1, 12, 135, 425, 10
    EDITTEXT IDC_CLOUD_NATIVE_FOLDER, 12, 150, 425, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Ready.", IDC_CLOUD_NATIVE_STATUS, 12, 179, 425, 25
    PUSHBUTTON "Forget saved login", IDC_CLOUD_NATIVE_FORGET, 12, 219, 105, 20
    DEFPUSHBUTTON "Upload document", IDOK, 270, 219, 95, 20
    PUSHBUTTON "Cancel", IDCANCEL, 374, 219, 63, 20
END


/* Read-only revision history and recovery; deliberately modeless. */
IDD_CLOUD_HISTORY DIALOGEX 0, 0, 485, 285
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WordPad(Custom) - Google Drive Version History"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Available Google Drive revisions (most recent first):", -1, 12, 12, 460, 12
    LISTBOX IDC_CLOUD_HISTORY_LIST, 12, 30, 460, 175, LBS_NOTIFY | WS_TABSTOP | WS_VSCROLL | WS_BORDER
    LTEXT "Loading...", IDC_CLOUD_HISTORY_STATUS, 12, 211, 460, 18
    LTEXT "Recovery creates a separate file; automatic retention only cleans up app-managed revisions.", IDC_CLOUD_HISTORY_NOTICE, 12, 231, 460, 16
    PUSHBUTTON "Refresh", IDC_CLOUD_HISTORY_REFRESH, 12, 259, 80, 20
    DEFPUSHBUTTON "Download selected...", IDC_CLOUD_HISTORY_DOWNLOAD, 250, 259, 138, 20
    PUSHBUTTON "Close", IDCANCEL, 397, 259, 75, 20
END
