/* Second mode of the Bulk Format Tool. Text Search retains its original dialog.
 * Matching rules are at the top and replacement rules below; these can
 * combine independently and do not modify unspecified attributes. */
IDD_BULK_FORMAT_SEARCH DIALOGEX 0, 0, 427, 474
