#include <windef.h>
#include <winuser.h>

#include "wordpad.h"

#define REACTOS_STR_FILE_DESCRIPTION  "WordPad(Custom)"
#define REACTOS_STR_INTERNAL_NAME     "wordpad"
#define REACTOS_STR_ORIGINAL_FILENAME "wordpad.exe"
#include <reactos/version.rc>

#include <reactos/manifest_exe.rc>

MAINACCELTABLE ACCELERATORS
BEGIN
    VK_F3,        ID_FIND_NEXT,       VIRTKEY
    "Q",          ID_ALIGN_LEFT,      VIRTKEY, CONTROL
    "Q",          ID_FORMAT_COLOR,    VIRTKEY, ALT
    "A",          ID_INSERT_AT_SIGN,   VIRTKEY, ALT
    "W",          ID_ALIGN_CENTER,    VIRTKEY, CONTROL
    "E",          ID_ALIGN_RIGHT,     VIRTKEY, CONTROL
    "F",          ID_FIND,            VIRTKEY, CONTROL
    "H",          ID_REPLACE,         VIRTKEY, CONTROL
    "K",          ID_INSERT_LINK,     VIRTKEY, CONTROL
    "A",          ID_EDIT_SELECTALL,  VIRTKEY, CONTROL
    "X",          ID_EDIT_CUT,        VIRTKEY, CONTROL
    "C",          ID_EDIT_COPY,       VIRTKEY, CONTROL
    "V",          ID_EDIT_PASTE_PLAIN,VIRTKEY, CONTROL, SHIFT
    "D",          ID_EDIT_PASTE_PLAIN,VIRTKEY, CONTROL
    "Z",          ID_EDIT_UNDO,       VIRTKEY, CONTROL
    "Y",          ID_EDIT_REDO,       VIRTKEY, CONTROL
    "B",          ID_FORMAT_BOLD,     VIRTKEY, CONTROL
    "I",          ID_FORMAT_ITALIC,   VIRTKEY, CONTROL
    "U",          ID_FORMAT_UNDERLINE,VIRTKEY, CONTROL
    "N",          ID_FILE_NEW,        VIRTKEY, CONTROL
    "O",          ID_FILE_OPEN,       VIRTKEY, CONTROL
    "S",          ID_FILE_SAVE,       VIRTKEY, CONTROL
	VK_F12,       ID_FILE_SAVE,       VIRTKEY, SHIFT
    "P",          ID_PRINT,           VIRTKEY, CONTROL
END

/* @makedep: toolbar.bmp */
IDB_TOOLBAR BITMAP "res/toolbar.bmp"

/* @makedep: formatbar.bmp */
IDB_FORMATBAR BITMAP "res/formatbar.bmp"
IDB_HIGHLIGHT_ICON BITMAP "res/highlight.bmp"
IDB_SUPERSCRIPT_ICON BITMAP "res/superscript.bmp"
IDB_SUBSCRIPT_ICON BITMAP "res/subscript.bmp"
IDB_PASTE_PLAIN_ICON BITMAP "res/paste_plain.bmp"
IDB_REMOVE_FORMATTING_ICON BITMAP "res/remove_format.bmp"

/* @makedep: wordpad.ico */
IDI_WORDPAD ICON "res/wordpad.ico"

/* @makedep: document.ico */
IDI_RTFDOC ICON "res/document.ico"

/* @makedep: zoom.cur */
IDC_ZOOM CURSOR "res/zoom.cur"

/* UTF-8 */
#pragma code_page(65001)

/* Shared simple line-spacing dialog; Italian labels are set by the dialog
 * procedure at runtime.  One neutral template avoids altering 27 languages. */
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
/* Automatic backups: shared English/Italian resource, using the established UI font. */
/* Compact layout: same configured 14-point UI font, smaller margins and
 * row spacing. The check option is custom-painted like selected radios. */
IDD_AUTOMATIC_BACKUP DIALOGEX 0, 0, 274, 114
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Automatic Backup"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    AUTOCHECKBOX "Enable automatic backup", IDC_BACKUP_ENABLED, 12, 6, 160, 20, WS_TABSTOP
    LTEXT "Maximum backups (minimum 1):", IDC_BACKUP_COUNT_LABEL, 12, 29, 193, 15
    EDITTEXT IDC_BACKUP_COUNT, 211, 27, 51, 19, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Backup interval (minutes):", IDC_BACKUP_INTERVAL_LABEL, 12, 50, 193, 15
    EDITTEXT IDC_BACKUP_INTERVAL, 211, 48, 51, 19, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Decimals accepted (0,5 = 30 seconds); minimum 1 second.", IDC_BACKUP_NOTE, 12, 72, 250, 14
    DEFPUSHBUTTON "OK", IDOK, 146, 91, 54, 19
    PUSHBUTTON "Cancel", IDCANCEL, 206, 91, 56, 19
END

/* Recovery lists every retained generation, newest first. */
IDD_BACKUP_RECOVERY DIALOGEX 0, 0, 389, 219
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Recover Automatic Backup"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Backups were found for this document. Select a version to recover, or open the original:", IDC_BACKUP_RECOVERY_LABEL, 10, 10, 366, 37
    LISTBOX IDC_BACKUP_RECOVERY_LIST, 10, 51, 369, 119, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON "Recover Selected", IDOK, 140, 187, 108, 22
    PUSHBUTTON "Open Original", IDC_BACKUP_ORIGINAL, 255, 187, 82, 22
    PUSHBUTTON "Cancel", IDCANCEL, 344, 187, 36, 22
END

/* Shared bilingual Link dialog. The per-language legacy IDD_INSERT_LINK
 * templates are retained for compatibility but are no longer opened. */
IDD_LINK_UNIFIED DIALOGEX 0, 0, 348, 156
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Link"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Text to display:", IDC_LINK_TEXT_LABEL, 10, 8, 328, 15
    EDITTEXT IDC_LINK_TEXT, 10, 25, 328, 17, ES_AUTOHSCROLL | WS_TABSTOP
    GROUPBOX "Link destination", IDC_LINK_KIND_LABEL, 10, 48, 328, 34
    AUTORADIOBUTTON "Web / email URL", IDC_LINK_KIND_URL, 18, 60, 145, 17, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Document bookmark", IDC_LINK_KIND_BOOKMARK, 173, 60, 157, 17, WS_TABSTOP
    LTEXT "Address (URL):", IDC_LINK_TARGET_LABEL, 10, 88, 328, 15
    EDITTEXT IDC_LINK_URL, 10, 105, 328, 17, ES_AUTOHSCROLL | WS_TABSTOP
    COMBOBOX IDC_LINK_BOOKMARK, 10, 105, 328, 135, CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Use source text", IDC_LINK_USE_SOURCE, 10, 130, 115, 20
    DEFPUSHBUTTON "Add Link", IDOK, 209, 130, 65, 20
    PUSHBUTTON "Cancel", IDCANCEL, 282, 130, 56, 20
END

/* An unresolved hyperlink offers explicit OK and Recover actions. */
IDD_BOOKMARK_MISSING DIALOGEX 0, 0, 334, 88
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bookmark Not Found"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "The destination bookmark does not exist.", IDC_BOOKMARK_MISSING_TEXT, 12, 15, 310, 25
    DEFPUSHBUTTON "OK", IDOK, 150, 54, 66, 23
    PUSHBUTTON "Recover Bookmarks...", IDC_BOOKMARK_OPEN_RECOVERY, 225, 54, 97, 23
END

/* Recovery diagnoses unresolved internal URLs and changes all their links. */
IDD_BOOKMARK_RECOVER DIALOGEX 0, 0, 350, 230
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Recover Broken Bookmark Links"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Unresolved bookmark targets (with link counts):", IDC_BOOKMARK_RECOVER_DESC, 9, 8, 332, 16
    LISTBOX IDC_BOOKMARK_DEAD_LIST, 9, 26, 332, 103, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "Reassign selected target to an existing bookmark:", IDC_BOOKMARK_RECOVER_LABEL, 9, 137, 332, 18
    COMBOBOX IDC_BOOKMARK_RECOVER_TO, 9, 156, 332, 112, CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Reassign All Links", IDOK, 166, 198, 109, 21
    PUSHBUTTON "Close", IDCANCEL, 283, 198, 58, 21
END

/* Bookmark dialogs; labels switch to Italian in code. */
IDD_BOOKMARK_ADD DIALOGEX 0, 0, 300, 80
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Bookmark"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Name (invalid characters become _):", IDC_BOOKMARK_NAME_LABEL, 9, 9, 282, 15
    EDITTEXT IDC_BOOKMARK_NAME, 9, 28, 282, 17, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Add", IDOK, 20, 54, 54, 20
    PUSHBUTTON "Use selected text", IDC_BOOKMARK_USE_SELECTED, 81, 54, 140, 20, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 229, 54, 56, 20
END

IDD_BOOKMARK_CHOOSE DIALOGEX 0, 0, 290, 126
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bookmarks"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Target bookmark:", IDC_BOOKMARK_TARGET_LABEL, 9, 8, 268, 15
    COMBOBOX IDC_BOOKMARK_TARGET, 9, 25, 270, 145, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Text to display (for links):", IDC_BOOKMARK_TEXT_LABEL, 9, 61, 268, 14
    EDITTEXT IDC_BOOKMARK_TEXT, 9, 79, 270, 24, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Delete Bookmark", IDC_BOOKMARK_DELETE, 9, 101, 146, 19, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 165, 101, 52, 19
    PUSHBUTTON "Cancel", IDCANCEL, 225, 101, 54, 19
END

IDD_LINE_SPACING DIALOGEX 0, 0, 214, 75
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Line spacing"
FONT RWP_UI_LEGACY_TEMPLATE_FONT_PT, RWP_UI_LEGACY_TEMPLATE_FONT_FAMILY
BEGIN
    LTEXT "Multiplier (e.g. 1, 1.5, 2):", IDC_LINE_SPACING_LABEL, 9, 12, 128, 13
    EDITTEXT IDC_LINE_SPACING_VALUE, 144, 9, 60, 15, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 98, 46, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 155, 46, 50, 15
END

/* Whole-document relative font resizer; Italian labels are set at runtime. */
IDD_GENERAL_FONT_RESIZER DIALOGEX 0, 0, 188, 70
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "General Font Resizer"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Enter added size (use - for size reduction):", IDC_GENERAL_FONT_RESIZER_LABEL, 10, 8, 170, 14
    EDITTEXT IDC_GENERAL_FONT_RESIZER_VALUE, 10, 26, 40, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Accepted values: -99 to +99 pt", IDC_GENERAL_FONT_RESIZER_RANGE, 57, 26, 124, 15
    DEFPUSHBUTTON "OK", IDOK, 91, 47, 40, 16
    PUSHBUTTON "Cancel", IDCANCEL, 137, 47, 42, 16
END

/* Shortcut summary window; Italian labels are set at runtime. */
IDD_SHORTCUTS DIALOGEX 0, 0, 260, 184
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Shortcut commands"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    EDITTEXT IDC_SHORTCUTS_TEXT, 8, 8, 244, 141, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Close", IDCANCEL, 201, 155, 51, 18
END

/* Document statistics window; Italian labels are set at runtime. */
/* Compact width (158 vs 238 units in V3), with the same label/value gap.
 * Runtime rwp_align_counter_values() places each value after the labels. */
IDD_DOCUMENT_COUNTER DIALOGEX 0, 0, 158, 92
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Document counter"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Characters (excluding spaces):", IDC_COUNTER_CHARS_NOSPACE_LABEL, 10, 12, 128, 14
    LTEXT "0", IDC_COUNTER_CHARS_NOSPACE_VALUE, 102, 12, 44, 14
    LTEXT "Characters (including spaces):", IDC_COUNTER_CHARS_LABEL, 10, 28, 128, 14
    LTEXT "0", IDC_COUNTER_CHARS_VALUE, 102, 28, 44, 14
    LTEXT "Words:", IDC_COUNTER_WORDS_LABEL, 10, 44, 128, 14
    LTEXT "0", IDC_COUNTER_WORDS_VALUE, 102, 44, 44, 14
    LTEXT "Document size:", IDC_COUNTER_SIZE_LABEL, 10, 60, 128, 14
    LTEXT "0 KB", IDC_COUNTER_SIZE_VALUE, 102, 60, 44, 14
    PUSHBUTTON "Refresh", IDC_COUNTER_REFRESH, 44, 74, 48, 16
    DEFPUSHBUTTON "Close", IDCANCEL, 98, 74, 48, 16
END

/* Shared insert-table dialog; Italian labels are set at runtime. */
IDD_INSERT_TABLE DIALOGEX 0, 0, 238, 112
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Insert table"
FONT RWP_UI_LEGACY_TEMPLATE_FONT_PT, RWP_UI_LEGACY_TEMPLATE_FONT_FAMILY
BEGIN
    LTEXT "Rows:", IDC_TABLE_ROWS_LABEL, 10, 14, 75, 13
    EDITTEXT IDC_TABLE_ROWS, 88, 11, 46, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Columns:", IDC_TABLE_COLUMNS_LABEL, 10, 36, 75, 13
    EDITTEXT IDC_TABLE_COLUMNS, 88, 33, 46, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Border color...", IDC_TABLE_BORDER_BUTTON, 10, 61, 105, 18
    CONTROL "", IDC_TABLE_BORDER_SWATCH, "STATIC", SS_OWNERDRAW | WS_BORDER, 123, 61, 24, 18
    DEFPUSHBUTTON "OK", IDOK, 126, 88, 48, 15
    PUSHBUTTON "Cancel", IDCANCEL, 180, 88, 48, 15
END

/* Table management. An unchanged width or unchosen color leaves the current
 * cell's edge alone. All-sides changes are overridden by specific edges. */
IDD_TABLE_MANAGEMENT DIALOGEX 0, 0, 368, 241
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Table management"
FONT RWP_UI_LEGACY_TEMPLATE_FONT_PT, RWP_UI_LEGACY_TEMPLATE_FONT_FAMILY
BEGIN
    LTEXT "Row height (mm):", IDC_TABLE_MGMT_HEIGHT_LABEL, 10, 10, 148, 13
    EDITTEXT IDC_TABLE_MGMT_HEIGHT, 156, 7, 65, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Column width (mm):", IDC_TABLE_MGMT_WIDTH_LABEL, 10, 31, 148, 13
    EDITTEXT IDC_TABLE_MGMT_WIDTH, 156, 28, 65, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT "Edge", IDC_TABLE_MGMT_EDGE_HEADER, 10, 49, 70, 13
    LTEXT "Thickness", IDC_TABLE_MGMT_THICKNESS_LABEL, 92, 49, 100, 13
    LTEXT "Color", IDC_TABLE_MGMT_COLOR_HEADER, 212, 49, 85, 13

    LTEXT "All sides", IDC_TABLE_MGMT_ALL_LABEL, 10, 70, 76, 14
    COMBOBOX IDC_TABLE_MGMT_THICKNESS, 92, 66, 108, 105, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Choose...", IDC_TABLE_MGMT_COLOR_BUTTON, 212, 66, 91, 19
    CONTROL "", IDC_TABLE_MGMT_COLOR_SWATCH, "STATIC", SS_OWNERDRAW | WS_BORDER, 315, 66, 27, 19

    LTEXT "Top", IDC_TABLE_MGMT_TOP_LABEL, 10, 92, 76, 14
    COMBOBOX IDC_TABLE_MGMT_TOP_WIDTH, 92, 88, 108, 105, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Choose...", IDC_TABLE_MGMT_TOP_COLOR_BUTTON, 212, 88, 91, 19
    CONTROL "", IDC_TABLE_MGMT_TOP_COLOR_SWATCH, "STATIC", SS_OWNERDRAW | WS_BORDER, 315, 88, 27, 19

    LTEXT "Bottom", IDC_TABLE_MGMT_BOTTOM_LABEL, 10, 114, 76, 14
    COMBOBOX IDC_TABLE_MGMT_BOTTOM_WIDTH, 92, 110, 108, 105, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Choose...", IDC_TABLE_MGMT_BOTTOM_COLOR_BUTTON, 212, 110, 91, 19
    CONTROL "", IDC_TABLE_MGMT_BOTTOM_COLOR_SWATCH, "STATIC", SS_OWNERDRAW | WS_BORDER, 315, 110, 27, 19

    LTEXT "Left", IDC_TABLE_MGMT_LEFT_LABEL, 10, 136, 76, 14
    COMBOBOX IDC_TABLE_MGMT_LEFT_WIDTH, 92, 132, 108, 105, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Choose...", IDC_TABLE_MGMT_LEFT_COLOR_BUTTON, 212, 132, 91, 19
    CONTROL "", IDC_TABLE_MGMT_LEFT_COLOR_SWATCH, "STATIC", SS_OWNERDRAW | WS_BORDER, 315, 132, 27, 19

    LTEXT "Right", IDC_TABLE_MGMT_RIGHT_LABEL, 10, 158, 76, 14
    COMBOBOX IDC_TABLE_MGMT_RIGHT_WIDTH, 92, 154, 108, 105, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Choose...", IDC_TABLE_MGMT_RIGHT_COLOR_BUTTON, 212, 154, 91, 19
    CONTROL "", IDC_TABLE_MGMT_RIGHT_COLOR_SWATCH, "STATIC", SS_OWNERDRAW | WS_BORDER, 315, 154, 27, 19

    LTEXT "Only selected cells are changed. Unchanged keeps existing widths; 0 pt hides an edge.", IDC_TABLE_MGMT_NOTE, 10, 179, 344, 28
    DEFPUSHBUTTON "OK", IDOK, 249, 215, 48, 17
    PUSHBUTTON "Cancel", IDCANCEL, 307, 215, 50, 17
END

/* Display size affects only the RTF picture's on-screen dimensions,
 * never the original PNG/JPEG data stored in the document. */
IDD_IMAGE_DISPLAY_SIZE DIALOGEX 0, 0, 252, 173
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Image display size"
FONT RWP_UI_LEGACY_TEMPLATE_FONT_PT, RWP_UI_LEGACY_TEMPLATE_FONT_FAMILY
BEGIN
    LTEXT "Original:", IDC_IMAGE_NATIVE_LABEL, 10, 9, 230, 13
    LTEXT "Currently displayed:", IDC_IMAGE_CURRENT_LABEL, 10, 25, 230, 13
    AUTORADIOBUTTON "Scale (%):", IDC_IMAGE_USE_PERCENT, 12, 49, 117, 13, WS_GROUP | WS_TABSTOP
    EDITTEXT IDC_IMAGE_PERCENT, 148, 45, 77, 17, ES_AUTOHSCROLL | WS_TABSTOP
    AUTORADIOBUTTON "Width (pixels):", IDC_IMAGE_USE_WIDTH, 12, 72, 117, 13, WS_TABSTOP
    EDITTEXT IDC_IMAGE_WIDTH, 148, 68, 77, 17, ES_AUTOHSCROLL | WS_TABSTOP
    AUTORADIOBUTTON "Height (pixels):", IDC_IMAGE_USE_HEIGHT, 12, 95, 117, 13, WS_TABSTOP
    EDITTEXT IDC_IMAGE_HEIGHT, 148, 91, 77, 17, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Aspect ratio is always preserved.", IDC_IMAGE_RATIO_NOTE, 12, 119, 220, 12
    DEFPUSHBUTTON "OK", IDOK, 139, 145, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 194, 145, 48, 16
END

/* Re-encode embedded PNG/JPEG pictures; 0 means unlimited dimension. */
IDD_IMAGE_COMPRESSION DIALOGEX 0, 0, 350, 182
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Document images compression"
FONT RWP_UI_FONT_PT, RWP_UI_FONT_FAMILY
BEGIN
    LTEXT "Convert all PNG/JPEG pictures to JPEG, including existing JPEGs.", IDC_COMPRESS_SCOPE, 12, 9, 326, 14
    LTEXT "JPEG quality (1-100):", IDC_COMPRESS_QUALITY_LABEL, 12, 32, 242, 13
    EDITTEXT IDC_COMPRESS_QUALITY, 272, 29, 66, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Maximum width (px):", IDC_COMPRESS_WIDTH_LABEL, 12, 53, 242, 13
    EDITTEXT IDC_COMPRESS_WIDTH, 272, 50, 66, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Maximum height (px):", IDC_COMPRESS_HEIGHT_LABEL, 12, 74, 242, 13
    EDITTEXT IDC_COMPRESS_HEIGHT, 272, 71, 66, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "0 = unlimited. Aspect ratio is preserved; images are never enlarged.", IDC_COMPRESS_LIMIT_NOTE, 12, 94, 326, 14
    LTEXT "WARNING: Any image editing alters or removes the original image's metadata. Transparent areas become white. Lossy changes cannot be undone with Ctrl+Z; make a backup first.", IDC_COMPRESS_METADATA_NOTE, 12, 114, 326, 38
    DEFPUSHBUTTON "Compress", IDOK, 220, 158, 64, 18
    PUSHBUTTON "Cancel", IDCANCEL, 290, 158, 48, 18
END

/* Shared add-table-items dialog; labels/title are localized at runtime. */
IDD_TABLE_COUNT DIALOGEX 0, 0, 208, 69
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Table"
FONT RWP_UI_LEGACY_TEMPLATE_FONT_PT, RWP_UI_LEGACY_TEMPLATE_FONT_FAMILY
BEGIN
    LTEXT "Count:", IDC_TABLE_COUNT_LABEL, 10, 14, 92, 13
    EDITTEXT IDC_TABLE_COUNT_VALUE, 108, 11, 48, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 98, 43, 48, 15
    PUSHBUTTON "Cancel", IDCANCEL, 152, 43, 48, 15
END


/* Bulk Format Tool: used by Format menu and the standard Replace dialog. */
IDD_BULK_FORMAT DIALOGEX 0, 0, 427, 310
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bulk Format Tool"
FONT RWP_UI_LEGACY_TEMPLATE_FONT_PT, RWP_UI_LEGACY_TEMPLATE_FONT_FAMILY
BEGIN
    LTEXT "Find text:", IDC_BULK_SEARCH_LABEL, 10, 11, 78, 12
    EDITTEXT IDC_BULK_FIND, 91, 8, 325, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Property", -1, 10, 34, 75, 12
    LTEXT "Action", -1, 93, 34, 175, 12
    LTEXT "Value (when applying)", -1, 278, 34, 138, 12

    LTEXT "Font", IDC_BULK_FONT_LABEL, 10, 53, 75, 12
    AUTORADIOBUTTON "Don't Change", IDC_BULK_FONT_NONE, 89, 51, 78, 14, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Apply", IDC_BULK_FONT_APPLY, 171, 51, 53, 14
    COMBOBOX IDC_BULK_FONT_VALUE, 278, 50, 138, 115, CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP

    LTEXT "Font Size", IDC_BULK_SIZE_LABEL, 10, 80, 75, 12
    AUTORADIOBUTTON "Don't Change", IDC_BULK_SIZE_NONE, 89, 78, 78, 14, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Apply", IDC_BULK_SIZE_APPLY, 171, 78, 53, 14
    EDITTEXT IDC_BULK_SIZE_VALUE, 278, 77, 56, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "pt (1-500)", -1, 342, 80, 72, 13

    LTEXT "Font Color", IDC_BULK_COLOR_LABEL, 10, 107, 75, 12
    AUTORADIOBUTTON "Don't Change", IDC_BULK_COLOR_NONE, 89, 105, 78, 14, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Apply", IDC_BULK_COLOR_APPLY, 171, 105, 53, 14
    CONTROL "Choose color...", IDC_BULK_COLOR_VALUE, "BUTTON", BS_OWNERDRAW | WS_VISIBLE | WS_TABSTOP, 278, 103, 138, 18

    LTEXT "Bold", IDC_BULK_BOLD_LABEL, 10, 134, 75, 12
    AUTORADIOBUTTON "Don't Change", IDC_BULK_BOLD_NONE, 89, 132, 78, 14, WS_GROUP | WS_TABSTOP
