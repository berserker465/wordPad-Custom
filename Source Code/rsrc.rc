    DEFPUSHBUTTON "Insert", IDC_SYMBOL_INSERT, 287, 244, 67, 20
    PUSHBUTTON "Close", IDCANCEL, 361, 244, 65, 20
END

/* Unified Search & Replace: two collapsible format panels share the same
 * workspace; ordinary Ctrl+H starts as a compact text-only dialog. */
